# Database Configuration
# For local development (SQLite - no installation needed)
DATABASE_URL=sqlite+aiosqlite:///./trading_portal.db

# For production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading_portal

# 한국투자증권 Open API
# https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
